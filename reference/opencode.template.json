{
  "$schema": "https://opencode.ai/config.json",
  "model": "workplace-ai/qwen3.8-27b",
  "small_model": "workplace-ai/qwen3.8-27b",
  "share": "disabled",
  "lsp": true,
  "provider": {
    "workplace-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "IGF Workplace AI (Komputer Putih)",
      "options": {
        "baseURL": "__BASE_URL__",
        "apiKey": "__UNSLOTH_API_KEY__"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "IGF Workplace AI",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "reasoning_effort": "xhigh"
        },
        "qwen3.8-27b-thinking": {
          "name": "Qwen 3.8 Local (thinking)",
          "tool_call": true,
          "temperature": true,
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "reasoning_effort": "xhigh"
        }
      }
    }
  },
  "agent": {
    "build": {
      "temperature": 0.3,
      "top_p": 0.85
    },
    "plan": {
      "model": "workplace-ai/qwen3.8-27b-thinking",
      "temperature": 0.4,
      "top_p": 0.9
    },
    "reviewer": {
      "description": "Read-only code review. Use proactively after multi-file edits or before committing.",
      "mode": "subagent",
      "temperature": 0.2,
      "top_p": 0.8,
      "color": "warning",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask"
        }
      }
    },
    "bioinformatician": {
      "description": "Nextflow/Quarto/bioinformatics tasks on a production genomics stack (conda envs, nf-core conventions). Use for pipelines, reports, HPC jobs.",
      "mode": "subagent",
      "temperature": 0.3,
      "top_p": 0.85
    },
    "skeptic": {
      "description": "Read-only pre-implementation red team. Attacks a plan before code is written — failure modes, hidden assumptions, simpler alternatives. Use after planning, before build.",
      "mode": "subagent",
      "model": "workplace-ai/qwen3.8-27b-thinking",
      "temperature": 0.4,
      "top_p": 0.9,
      "color": "error",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 20000
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true,
      "timeout": 20000
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@2026.7.4"
      ],
      "enabled": true,
      "timeout": 15000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.79"
      ],
      "enabled": true,
      "environment": {
        "PLAYWRIGHT_NO_SANDBOX": "1"
      }
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory@2026.7.4"
      ],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": "__MEMORY_PATH__"
      }
    }
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 12
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "bash": {
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "sudo rm*": "deny",
      "mkfs*": "deny",
      "dd if=* of=/dev/*": "deny",
      "chmod -R 777 *": "deny",
      "curl * | bash": "deny",
      "curl * | sh": "deny",
      "wget * | bash": "deny",
      "wget * | sh": "deny"
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail"
  ]
}
